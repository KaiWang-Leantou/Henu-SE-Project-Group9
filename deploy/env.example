# 复制为 /etc/whiteboard/wb.env，权限 600、属主 wb
# 注意：这个文件永远不要提交到 git

# ---- 必填 ----
# 生成方式：openssl rand -base64 48
WB_JWT_SECRET=请替换成随机长字符串

# MySQL 连接（与 deploy/docker-compose.yml 里的库名/账号对应）
WB_DB_URL=jdbc:mysql://127.0.0.1:3306/wb?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
WB_DB_USER=wb
WB_DB_PASSWORD=请替换成强密码

# ---- 可选 ----
# 允许无 token 的匿名连接（默认 false；演示时可临时开）
# WB_AUTH_ALLOW_ANONYMOUS=false
