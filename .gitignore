.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.p8
*.pfx
*.crt
*.cer
*.der
id_rsa*
id_dsa*
id_ed25519*
.netrc

secrets.json
credentials.json
config/secrets.*
*secret*
*password*
*credential*
*token*
*api*key*
*apikey*
*access*token*
*oauth*token*
*refresh*token*

# 云服务凭据
.aws/credentials
.aws/config
gcp-keyfile.json
azure-credentials.json

